FUNCTION altsyncram_in1i (address_a[10..0], address_b[10..0], clock0, data_a[513..0], wren_a)
RETURNS ( q_b[513..0]);

--synthesis_resources = M20K 52 
SUBDESIGN altera_syncram_hqkk
( 
	address_a[10..0]	:	input;
	address_b[10..0]	:	input;
	clock0	:	input;
	data_a[513..0]	:	input;
	q_b[513..0]	:	output;
	wren_a	:	input;
) 
VARIABLE 
	altsyncram1 : altsyncram_in1i;

BEGIN 
	altsyncram1.address_a[] = address_a[];
	altsyncram1.address_b[] = address_b[];
	altsyncram1.clock0 = clock0;
	altsyncram1.data_a[] = data_a[];
	altsyncram1.wren_a = wren_a;
	q_b[] = altsyncram1.q_b[];
END;
