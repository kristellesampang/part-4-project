# Project-Wide Assignments
# ========================
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "15:07:22  DECEMBER 05, 2025"
set_global_assignment -name LAST_QUARTUS_VERSION "24.1.0 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_FILE "../Systolic Array/BRAM_Controller_Test.vhd"
set_global_assignment -name VHDL_FILE SummerResearchTopLevel.vhd
set_global_assignment -name VHDL_FILE "../Systolic Array/top_level_systolic_array.vhd"
set_global_assignment -name VHDL_FILE "../Systolic Array/systolic_array.vhd"
set_global_assignment -name VHDL_FILE "../Systolic Array/processing_element.vhd"
set_global_assignment -name VHDL_FILE "../Systolic Array/custom_types.vhd"
set_global_assignment -name VHDL_FILE "../Systolic Array/control_unit.vhd"
set_global_assignment -name REVISION_TYPE PR_BASE

# Pin & Location Assignments
# ==========================
set_location_assignment PIN_AJ13 -to LED_STATUS[6]
set_location_assignment PIN_K12 -to BTN_RESET
set_location_assignment PIN_H13 -to BTN_START
set_location_assignment PIN_AH14 -to LED_STATUS[2]
set_location_assignment PIN_AG14 -to LED_STATUS[3]
set_location_assignment PIN_AF15 -to LED_STATUS[0]
set_location_assignment PIN_AF14 -to LED_STATUS[4]
set_location_assignment PIN_AJ14 -to LED_STATUS[1]
set_location_assignment PIN_AK13 -to LED_STATUS[5]
set_location_assignment PIN_AH12 -to LED_STATUS[7]
set_location_assignment PIN_AG15 -to LED_DONE
set_location_assignment PIN_F5 -to CLK_50
set_location_assignment PIN_AG5 -to CLK_EMI
set_location_assignment PIN_AK3 -to ddr4_emif_mem_mem_a[8]
set_location_assignment PIN_AF5 -to ddr4_emif_mem_mem_ba[0]

# Analysis & Synthesis Assignments
# ================================
set_global_assignment -name TOP_LEVEL_ENTITY SummerResearchTopLevel
set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name BOARD "Intel Arria 10 SX SoC Development Kits DK-SOC-10AS066S-D"

# Fitter Assignments
# ==================
set_global_assignment -name DEVICE 10AS066N3F40E2SG
set_global_assignment -name OPTIMIZE_IOC_REGISTER_PLACEMENT_FOR_TIMING NORMAL

# EDA Netlist Writer Assignments
# ==============================
set_global_assignment -name EDA_SIMULATION_TOOL "QuestaSim (VHDL)"

# Logic Lock Region Assignments
# =============================
set_instance_assignment -name PLACE_REGION "X1 Y1 X77 Y120" -to npu_core
set_instance_assignment -name RESERVE_PLACE_REGION ON -to npu_core
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to npu_core
set_instance_assignment -name REGION_NAME npu_core -to npu_core
set_instance_assignment -name ROUTE_REGION "X0 Y0 X79 Y122" -to npu_core
set_instance_assignment -name RESERVE_ROUTE_REGION ON -to npu_core

# Power Estimation Assignments
# ============================
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL

# start EDA_TOOL_SETTINGS(eda_simulation)
# ---------------------------------------

	# EDA Netlist Writer Assignments
	# ==============================
	set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VHDL -section_id eda_simulation
	set_global_assignment -name EDA_USER_COMPILED_SIMULATION_LIBRARY_DIRECTORY "C:/Users/pchh520/Documents/part-4-project/SummerResearch/quartus/Simulation" -section_id eda_simulation

