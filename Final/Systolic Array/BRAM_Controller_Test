-- This is a test controller for the BRAM components used in the Systolic Array NPU design.
-- Goal is to make the Port A of the BRAMs to tbe the NPU read port and the DMA Write port will be the Port B, where it will load new data/weights)
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use work.custom_types.all;

entity BRAM_Controller_Test is

    port (
        clk_in  : in  std_logic;
        reset_in  : in  std_logic
        start_transfer_cmd_in : in  std_logic;

        npu_data_read : out bit_16;
        npu_weight_read : out bit_16;

        current_buffer_is_ping : out std_logic
    );

end entity BRAM_Controller_Test;

architecture rtl of BRAM_Controller_Test is

    constant N_ADDR_BITS : integer := 10;

    signal ping_pong_sel : std_logic := '0';

    signal npu_addr : std_logic_vector(N_ADDR_BITS-1 downto 0);
    signal dma_addr : std_logic_vector(N_ADDR_BITS-1 downto 0);
    signal npu_addr_int : integer range 0 to 1023 := 0;
    signal dma_addr_int : integer range 0 to 1023 := 0;

    -- Data Signals from BRAM outputs (16 bits)
    signal ping_a_q : bit_16;
    signal pong_a_q : bit_16;
    signal ping_b_q : bit_16;
    signal pong_b_q : bit_16;
    signal output_c_q : std_logic_vector(63 downto 0);

    signal dma_write_data_16 : bit_16 := (others => '0');
    signal dma_write_data_64 : std_logic_vector(63 downto 0) := (others => '0');

    signal ping_a_wren, pong_a_wren : std_logic := '0';
    signal ping_a_wren, pong_b_wren : std_logic := '0';
    signal output_c_wren : std_logic := '0';

    type state_t is (S_IDLE, S_PING_COMPUTE, S_WAIT_PONG_LOAD, S_SWITCH, S_PONG_COMPUTE);
    signal current_state : state_t := S_IDLE;

    -- Component Declaration for the BRAM Controller
    -- ALL 5
    --  Data_ROM_inst : component data_rom port map (address => data_rom_addr, clock => clk, q => data_rom_q);
    
	component DataBuffer1 is
		port (
			data_a    : in  std_logic_vector(15 downto 0);
			q_a       : out std_logic_vector(15 downto 0);                  
			data_b    : in  std_logic_vector(15 downto 0); 
			q_b       : out std_logic_vector(15 downto 0);                    
			address_a : in  std_logic_vector(9 downto 0); 
			address_b : in  std_logic_vector(9 downto 0);  
			wren_a    : in  std_logic;                     
			wren_b    : in  std_logic;             
			clock     : in  std_logic;                 
			freeze    : in  std_logic;                   
			enable    : in  std_logic;                     
			aclr      : in  std_logic
        );            
	end component DataBuffer1;

    component DataBuffer2 is
		port (
			data_a    : in  std_logic_vector(15 downto 0);
			q_a       : out std_logic_vector(15 downto 0);                  
			data_b    : in  std_logic_vector(15 downto 0); 
			q_b       : out std_logic_vector(15 downto 0);                    
			address_a : in  std_logic_vector(9 downto 0); 
			address_b : in  std_logic_vector(9 downto 0);  
			wren_a    : in  std_logic;                     
			wren_b    : in  std_logic;             
			clock     : in  std_logic;                 
			freeze    : in  std_logic;                   
			enable    : in  std_logic;                     
			aclr      : in  std_logic
        );            
	end component DataBuffer2;

    component WeightBuffer1 is
		port (
			data_a    : in  std_logic_vector(15 downto 0);
			q_a       : out std_logic_vector(15 downto 0);                  
			data_b    : in  std_logic_vector(15 downto 0); 
			q_b       : out std_logic_vector(15 downto 0);                    
			address_a : in  std_logic_vector(9 downto 0); 
			address_b : in  std_logic_vector(9 downto 0);  
			wren_a    : in  std_logic;                     
			wren_b    : in  std_logic;             
			clock     : in  std_logic;                 
			freeze    : in  std_logic;                   
			enable    : in  std_logic;                     
			aclr      : in  std_logic
        );            
	end component WeightBuffer1;

    component WeightBuffer2 is
		port (
			data_a    : in  std_logic_vector(15 downto 0);
			q_a       : out std_logic_vector(15 downto 0);                  
			data_b    : in  std_logic_vector(15 downto 0); 
			q_b       : out std_logic_vector(15 downto 0);                    
			address_a : in  std_logic_vector(9 downto 0); 
			address_b : in  std_logic_vector(9 downto 0);  
			wren_a    : in  std_logic;                     
			wren_b    : in  std_logic;             
			clock     : in  std_logic;                 
			freeze    : in  std_logic;                   
			enable    : in  std_logic;                     
			aclr      : in  std_logic
        );            
	end component WeightBuffer2;


    
	component OutputBuffer is
		port (
			data_a    : in  std_logic_vector(63 downto 0);
			q_a       : out std_logic_vector(63 downto 0);                    -- dataout_a
			data_b    : in  std_logic_vector(63 downto 0); 
			q_b       : out std_logic_vector(63 downto 0);                   
			address_a : in  std_logic_vector(9 downto 0);  
			address_b : in  std_logic_vector(9 downto 0); 
			wren_a    : in  std_logic;                
			clock     : in  std_logic;                
			freeze    : in  std_logic;             
			enable    : in  std_logic;      
			aclr      : in  std_logic            
		);
	end component OutputBuffer;



begin
    -- For debugging output
    current_buffer_is_ping <= not ping_pong_sel;

    -- Buffer Switching FSM
    process(clk_in, reset_in)
    begin
        if reset_in = '1' then
            current_state <= S_PING_COMPUTE;
            ping_pong_sel <= '0';
        elsif rising_edge(clk_in) then
            case current_state is
                when S_PING_COMPUTE =>
                    if start_transfer_cmd = '1' then
                        current_state <= S_SWITCH; -- Kinda problematic
                    end if;
                when S_SWITCH =>
                    ping_pong_sel <= not ping_pong_sel;
                    if ping_pong_sel = '1' then
                        current_state = '1' then
                    else
                        current_state <= S_PING_COMPUTE;
                    end if;
                when S_PONG_COMPUTE =>
                    if start_transfer_cmd = '1' then
                        current_state <= S_SWITCH; -- Kinda problematic
                    end if;
                when S_WAIT_PONG_LOAD =>
                    -- Wait state to ensure data is loaded
                    current_state <= S_SWITCH;
            end case;
        end if;
    end process;

    process(ping_pong_sel, ping_a_data_out, pong_a_data_out)
    begin
        if ping_pong_sel = '0' then
            npu_data_read <= ping_a_data_out;
        else
            npu_data_read <= pong_a_data_out;
        end if;
    end process;
