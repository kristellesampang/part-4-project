	keywords = {Computer Science - Hardware Architecture},
	file = {PDF:C\:\\Users\\OEM\\Zotero\\storage\\4WPLSIPQ\\Parameshwara and Mokashi - 2025 - FPGA-Accelerated RISC-V ISA Extensions for Efficient Neural Network Inference on Edge Devices.pdf:application/pdf},
}

