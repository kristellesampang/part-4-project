# Compiled libraries/workspaces
# Should be safe to ignore these as they can be regenerated.
*.fdb
*.mpf
*.spd
*.do # Unless you manually create .do files for custom simulations.
     # If you create custom .do files, make them explicit in a "keep" section or list them.

# Waveform files (user-generated, typically)
*.ucdb

# Eclipse/Other IDE files (often generated in project roots)
.project
.settings/
.cproject
.build/

# Operating System temporary files
# -------------------------------
*.DS_Store
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Python / MATLAB bytecode and environment files
# ---------------------------------------------
*.pyc
__pycache__/
.ipynb_checkpoints/
.pytest_cache/
.coverage
.mypy_cache/
.venv/
venv/
env/
.env

# Custom ignores for your project (add more here if needed)
# --------------------------------------------------------
# For example, if you have custom .do files for ModelSim you want to keep:
# !/src/my_custom_sim.do 
#
# If you have specific .txt reports you always want to commit:
# !/docs/final_report.txt